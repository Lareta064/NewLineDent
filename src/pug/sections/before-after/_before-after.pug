mixin tabsRightContent
	//блок для десктоп версии
	.rotate-image__group.hide-sm
		.rotate-image.rotate-image1
			img(src='./img/service-cards/img1.webp', srcset='./img/service-cards/img1@2x.webp 2x' width='332' height='239' loading='lazy' alt='img')
			.flex
				span.img-caption.img-caption--name До
				span.img-logo
				
		.rotate-image.rotate-image2
			img(src='./img/service-cards/img2.webp', srcset='./img/service-cards/img2@2x.webp 2x' width='332' height='239' loading='lazy' alt='img')
			.flex
				span.img-caption.img-caption--name После
				span.img-logo
	
	
		
	
	//buttons-group
	

mixin singleSlide
	//slider for mobile
	.mySwiper.swiper.block-sm
		.swiper-wrapper
			.swiper-slide
				.rotate-image.block-sm
					img(src='./img/service-cards/img1.webp', srcset='./img/service-cards/img1@2x.webp 2x' width='332' height='239' loading='lazy' alt='img')
					.flex
						span.img-caption.img-caption--name До
						span.img-logo
			.swiper-slide
				.rotate-image
					img(src='./img/service-cards/img1.webp', srcset='./img/service-cards/img1@2x.webp 2x' width='332' height='239' loading='lazy' alt='img')
					.flex
						span.img-caption.img-caption--name До
		//navigation mobile
		.mySwiper-nav.flex
			button.arrow-prev
				svg.svg-rarr
					use(href='./img/sprite.svg#svg-rarr')
			button.arrow-next
				svg.svg-rarr
					use(href='./img/sprite.svg#svg-rarr')
	
	//slider for desktop
	.before-after-swiper.swiper.hide-sm
		.swiper-wrapper
			.swiper-slide
				//RIGHT CONTENT slider
				.before-after__right
					+tabsRightContent
			.swiper-slide
				//RIGHT CONTENT slider
				.before-after__right
					+tabsRightContent


		//slider navigation desktop
		.before-after-nav.align-right-buttons
			button.before-after-prev.btn.btn--accent Назад
			button.before-after-next.btn-primary Перейти к следующему
			
			
mixin ba-slider(txt)
	.before-after-wrapper
		//LEFT CONTENT
		.before-after__left
			.user-card
				.user-card__img
					img(src='./img/user1.webp' width='329' height='280' loading='lazy' alt='img')

				.user-card__body
					.card__body-group
						.title-24 #{txt}
						span.txt-bold Эстетическая тератия
					.card__body-group
						span.txt-bold Лечащий врач 
						p.txt-16  Вера Павловна Твердохлебова
					.card__body-group
						.flex
							span.clock-icon
							span.clock-icon
							span.clock-icon
						.flex
							span.coins-icon
							span.coins-icon
							span.coins-icon.disable
				.before-after__buttons
					a(href="#!").btn-accent.sm-100 Получить такую улыбку 
			
		+singleSlide
					
section.before-after
	.container
		
		.before-after__tabs
			.tabs-group
				ul.tabs__nav.flex
					li.tabs__nav-btn.flex(data-tbat="all") Все
					
					li.tabs__nav-btn.flex(data-tbat="2") Терапия
					li.tabs__nav-btn.flex(data-tbat="3") Хирургия
					li.tabs__nav-btn.flex(data-tbat="4") Ортодонтия
					li.tabs__nav-btn.flex(data-tbat="5") Ортопедия
					li.tabs__nav-btn.flex(data-tbat="6") Гигиена
						
				
				.tabs__content-container
					//TAB #1
					.tabs-content.active(data-tcontent="all")
						+ba-slider('Вера Павловна Твердохлебова')
					
					//TAB #2
					.tabs-content(data-tcontent="2")
						+ba-slider('Елена Павловна Иванова')

					//TAB #3
					.tabs-content(data-tcontent="3")
						+ba-slider('Светлана Сергеевна Петрова')